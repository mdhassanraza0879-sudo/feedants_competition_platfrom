{
  "name": "feedants-competition-backend",
  "version": "1.0.0",
  "description": "Feedants Competition Details Platform - REST API Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "ts-node-dev src/seeds/seedData.ts",
    "test:concurrency": "ts-node-dev test-concurrency.ts"
  },
  "keywords": [
    "feedants",
    "express",
    "typescript",
    "mongodb",
    "mongoose"
  ],
